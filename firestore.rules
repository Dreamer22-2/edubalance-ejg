rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Authentication UID
    // Fields:
    //   - uid: string, required, immutable, must match the document ID
    //   - name: string, required, 1-120 characters
    //   - email: string, required, valid email, at most 254 characters
    //   - photoURL: string, required, empty or HTTP(S) URL, at most 2048 characters
    //   - role: string, required, one of visitor/user/admin/dev/owner
    //   - createdAt: timestamp, required, immutable
    //
    // This collection contains profile information. Users can read only their
    // own profile; admin/dev/owner roles can list profiles for User Management.
    //
    // All other collections and documents are denied by default.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return 'uid' in request.resource.data &&
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function isSchoolEmail() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('.*@[eE]5[vV][oO][sS][.][hH][uU]$');
    }

    function hasAdminAccess() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
          ['admin', 'dev', 'owner'];
    }

    function isValidUser(data, userId) {
      return hasRequiredFields(data, ['uid', 'name', 'email', 'photoURL', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'role', 'createdAt']) &&
        data.uid is string &&
        data.uid == userId &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^@ ]+@[^@ ]+$') &&
        data.photoURL is string &&
        data.photoURL.size() <= 2048 &&
        (data.photoURL == '' || data.photoURL.matches('^https?://.+$')) &&
        data.role in ['visitor', 'user', 'admin', 'dev', 'owner'] &&
        data.createdAt is timestamp;
    }

    function canCreateRole(role) {
      return role == 'visitor' ||
        (role == 'user' && isSchoolEmail());
    }

    function isValidRoleUpdate(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
        (
          (
            resource.data.role == 'owner' &&
            isOwner(userId) &&
            isDocOwner() &&
            request.resource.data.role in ['visitor', 'user', 'admin', 'dev', 'owner']
          ) ||
          (
            resource.data.role != 'owner' &&
            hasAdminAccess() &&
            request.resource.data.role in ['visitor', 'user', 'admin', 'dev']
          ) ||
          (
            resource.data.role != 'owner' &&
            hasAdminAccess() &&
            request.resource.data.role == 'owner' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
          ) ||
          (
            isOwner(userId) &&
            isDocOwner() &&
            resource.data.role == 'visitor' &&
            request.resource.data.role == 'user' &&
            isSchoolEmail()
          )
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || hasAdminAccess();
      allow list: if hasAdminAccess();

      allow create: if isOwner(userId) &&
        uidUnchanged() &&
        isValidUser(request.resource.data, userId) &&
        request.resource.data.email == request.auth.token.email &&
        canCreateRole(request.resource.data.role) &&
        request.resource.data.createdAt == request.time;

      allow update: if isValidUser(request.resource.data, userId) &&
        uidNotModified() &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidRoleUpdate(userId);

      // Privileged roles may remove another user's Firestore profile, except
      // owner profiles. This does not delete the Firebase Authentication account.
      allow delete: if hasAdminAccess() &&
        userId != request.auth.uid &&
        resource.data.role != 'owner';
    }
  }
}
